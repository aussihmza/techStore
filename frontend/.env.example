# Backend API base URL including /api (no trailing slash after /api)
# Local:  http://localhost:5000/api
# Render: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Same Google OAuth Web Client ID as backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=

# Optional: Google Analytics 4 — loads only after “Accept all” cookies
VITE_GA_MEASUREMENT_ID=
