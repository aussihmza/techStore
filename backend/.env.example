PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or local Mongo for development)
MONGODB_URI=mongodb://localhost:27017/techstore

# Comma-separated allowed browser origins (Vercel URL + local Vite)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Public storefront URL used for Stripe success/cancel redirects (no trailing slash)
FRONTEND_URL=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS=App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="TechStore <yourgmail@gmail.com>"

GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Comma-separated emails that become admin on login/register
ADMIN_EMAILS=you@example.com
